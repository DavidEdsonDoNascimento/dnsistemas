# Resend: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxx



# Remetente verificado no Resend (domínio próprio ou onboarding@resend.dev em testes)

# Ex.: "ANTERO <contato@suaorganizacao.com.br>"

MAIL_FROM=ANTERO <contato@suaorganizacao.com.br>



# Caixa que recebe os envios do formulário

MAIL_TO=contato@suaorganizacao.com.br



# URL canônica do site em produção (sem barra no final).
# Usada por metadata, Open Graph, robots.txt e sitemap.xml.

NEXT_PUBLIC_SITE_URL=https://anterosistemas.com.br



# ──────────────────────────────────────────────────────────────────────────────
# Supabase (autenticação do painel interno)
# Project Settings → API no dashboard do Supabase.
# Em dev, copiar para .env.local.
# ──────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

