# Formulário de contato (/api/contact) — envio via API HTTP do Resend (sem SMTP).
# As três variáveis abaixo são obrigatórias e lidas só no servidor:
# nunca usar o prefixo NEXT_PUBLIC_ nelas.
# Em dev, copiar para .env.local (ignorado pelo Git) e reiniciar o `npm run dev`.

# Resend: https://resend.com/api-keys (formato re_...)

RESEND_API_KEY=re_xxxxxxxx



# Remetente verificado no Resend (domínio próprio ou onboarding@resend.dev em testes)
# O domínio do remetente precisa estar verificado em resend.com/domains.
# onboarding@resend.dev só entrega para o e-mail dono da conta Resend.

# Ex.: "ANTERO <contato@suaorganizacao.com.br>"

MAIL_FROM=ANTERO <contato@suaorganizacao.com.br>



# Caixa que recebe os envios do formulário (um único endereço)

MAIL_TO=contato@suaorganizacao.com.br



# URL canônica do site em produção (sem barra no final).
# Usada por metadata, Open Graph, robots.txt e sitemap.xml.

NEXT_PUBLIC_SITE_URL=https://anterosistemas.com.br



# ──────────────────────────────────────────────────────────────────────────────
# Supabase (autenticação do painel interno)
# Project Settings → API no dashboard do Supabase.
# Em dev, copiar para .env.local.
# ──────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

